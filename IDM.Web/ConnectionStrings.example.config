<?xml version="1.0" encoding="utf-8"?>
<connectionStrings>
  <add name="DBConnection"
       connectionString="Server=YOUR_SQL_SERVER;Database=YOUR_DATABASE;Trusted_Connection=True;"
       providerName="System.Data.SqlClient" />
  <add name="DB2Connection"
       connectionString="Provider=IBMDADB2;Database=YOUR_DATABASE;Hostname=YOUR_HOST;Protocol=TCPIP;Port=YOUR_PORT;Uid=YOUR_USER;Pwd=YOUR_PASSWORD;"
       providerName="System.Data.OleDb" />
</connectionStrings>
